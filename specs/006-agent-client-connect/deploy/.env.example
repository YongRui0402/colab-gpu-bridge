# 主機上要掛到容器 /data 的資料夾(授權檔、CLI 狀態檔、SSH 金鑰、SQLite 都在這裡)。
# 留空時用 named volume cgb-data;要放在主機的指定資料夾就填它的路徑(例如 Unraid 的 appdata 底下)。
# 不要指到 repo 裡面:token.json 與私鑰不得進版本控制(NFR-010)。
CGB_HOST_DATA=

# 兩個入口綁定的主機位址(NFR-009:家中區網可連、不對外網公開)。
# 留空時是 0.0.0.0(主機所有介面);不對外網公開靠路由器不轉發這兩個 port。
# 主機有多張網路卡、只想開在區網那一張時,填那張網路卡在區網的位址。
# 注意:Docker 發布的 port 不經過主機的 ufw 規則,不能靠 ufw 擋外網。
CGB_BIND_ADDR=

# UI(瀏覽器開 http://<本系統所在主機>:<這個 port>/)在主機上的 port;留空時是 8780。
CGB_HOST_UI_PORT=

# Ollama 相容端點在主機上的 port;留空時是 11434(Ollama 的慣例,區網程式只要換主機名稱)。
# 連線設定頁的片段也用這個 port。
# 主機上已經有自己的 Ollama 在聽 11434 時(例如桌機),改填別的 port,例如 11436;
# 不要填 11435:那是容器內 SSH 通道用的 port,雖然不衝突但容易混淆。
CGB_HOST_OLLAMA_PORT=
